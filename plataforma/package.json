    "@codemirror/view": "^6.43.4",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@uiw/react-codemirror": "^4.25.10",
    "jszip": "^3.10.1",
