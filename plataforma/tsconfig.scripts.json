{
  /* Scripts de verificación (`scripts/`), que corren en Node pero importan el código de `src/`.
   *
   * Necesitan su propio tsconfig porque combinan dos mundos que los otros dos no mezclan:
   *  - resolución y strictness IDÉNTICAS a `tsconfig.app.json` (mismo `paths` para `@/*`, misma
   *    `moduleResolution: bundler`), porque importan módulos de `src/` que usan ese alias;
   *  - APIs de Node (`process`, `node:fs`) y sin `DOM`, porque no corren en el navegador.
   *
   * `tsconfig.node.json` no sirve: usa `module: nodenext`, que exige extensiones explícitas en
   * los imports de `src/` y no conoce `@/*`.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Misma strictness que la app: los scripts no son ciudadanos de segunda. */
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts"]
}
