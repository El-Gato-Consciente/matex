{
  "id": "article-pro-latex",
  "displayName": "Article — pdfLaTeX output",
  "profile": "article-pro",
  "target": "pdflatex",
  "description": "Serialization contract for article-pro documents targeting pdfLaTeX compilation.",

  "packages": {
    "mandatory": [
      "inputenc", "fontenc", "lmodern", "babel", "csquotes",
      "amsmath", "amssymb", "amsthm", "mathtools",
      "geometry", "microtype", "xurl", "hyperref", "bookmark", "cleveref"
    ],
    "optional": [
      "fancyhdr", "enumitem", "booktabs", "xcolor", "graphicx", "tikz"
    ],
    "loadOrder": [
      "inputenc", "fontenc", "lmodern", "babel", "csquotes",
      "amsmath", "amssymb", "amsthm", "mathtools",
      "geometry", "microtype",
      "fancyhdr", "enumitem", "booktabs",
      "xcolor", "graphicx", "tikz",
      "xurl", "hyperref", "bookmark",
      "cleveref"
    ]
  },

  "environmentStyles": {
    "definition":  "definition",
    "theorem":     "plain",
    "lemma":       "plain",
    "proposition": "plain",
    "corollary":   "plain",
    "remark":      "remark",
    "example":     "remark",
    "note":        "remark",
    "exercise":    "definition"
  },

  "geometry": {
    "left": "2.5cm", "right": "2.5cm",
    "top":  "2.5cm", "bottom": "2.5cm"
  },

  "cleveref": {
    "en": {},
    "es": {
      "theorem":     { "singular": "Teorema",     "plural": "Teoremas"      },
      "definition":  { "singular": "Definición",  "plural": "Definiciones"  },
      "lemma":       { "singular": "Lema",        "plural": "Lemas"         },
      "proposition": { "singular": "Proposición", "plural": "Proposiciones" },
      "corollary":   { "singular": "Corolario",   "plural": "Corolarios"    },
      "exercise":    { "singular": "Ejercicio",   "plural": "Ejercicios"    },
      "equation":    { "singular": "ecuación",    "plural": "ecuaciones"    }
    }
  }
}
