{
  "id": "article-pro",
  "displayName": "Article — Professional",
  "documentClass": "article",
  "classOptions": ["12pt", "a4paper"],
  "extends": "article-base",
  "normalizerMode": "mixed",
  "description": "University-level mathematical documents: homework, proofs, notes.",
  "tags": ["mathematics", "university", "exercises", "proofs"],

  "supportedNodes": {
    "block": [
      "paragraph", "heading", "mathDisplay", "theoremEnv",
      "bulletList", "orderedList", "blockquote", "rawLatex"
    ],
    "inline": [
      "mathInline", "crossRef", "text", "hardBreak"
    ]
  },

  "environments": {
    "supportedTypes": [
      "theorem", "lemma", "proposition", "corollary",
      "definition", "remark", "example", "note",
      "exercise", "proof"
    ],
    "sharedCounter": {
      "base": "definition",
      "members": ["theorem", "lemma", "proposition", "corollary",
                  "remark", "example", "note"]
    },
    "independentCounters": {
      "definition": { "resetBy": "section" },
      "exercise":   { "resetBy": "section" }
    }
  },

  "macros": {
    "\\R":     "\\mathbb{R}",
    "\\Q":     "\\mathbb{Q}",
    "\\Z":     "\\mathbb{Z}",
    "\\N":     "\\mathbb{N}",
    "\\C":     "\\mathbb{C}",
    "\\K":     "\\mathbb{K}",
    "\\abs":   "\\left\\lvert #1 \\right\\rvert",
    "\\norm":  "\\left\\lVert #1 \\right\\rVert",
    "\\inner": "\\left\\langle #1, #2 \\right\\rangle"
  },

  "mathOperators": {
    "\\rk":  "rk",
    "\\tr":  "tr",
    "\\im":  "Im",
    "\\Ker": "Ker"
  },

  "normalizerRules": {
    "ForbiddenSyntax":  { "enabled": true, "severity": "required"    },
    "MacroExpansion":   { "enabled": true, "severity": "required"    },
    "AutoDelimiters":   { "enabled": true, "severity": "required"    },
    "DxSpacing":        { "enabled": true, "severity": "required"    },
    "TextInMath":       { "enabled": true, "severity": "preferred"   },
    "AlignedSteps":     { "enabled": true, "severity": "opinionated" },
    "DisplayThreshold": { "enabled": true, "severity": "opinionated" }
  }
}
